PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgresql:///hutorynok?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql:///hutorynok_test?host=/var/run/postgresql
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=720
IDENTITY_STATE_TTL_MINUTES=10
CHANNEL_LINK_TTL_MINUTES=15
PII_ENCRYPTION_KEY=replace-with-64-hex-characters
DEV_IDENTITY_ENABLED=true
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./var/uploads
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
