PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgresql:///hutorynok?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql:///hutorynok_test?host=/var/run/postgresql
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=720
IDENTITY_STATE_TTL_MINUTES=10
CHANNEL_LINK_TTL_MINUTES=15
PII_ENCRYPTION_KEY=replace-with-64-hex-characters
DEV_IDENTITY_ENABLED=true
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./var/uploads
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_LINK_MAX=60
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_CHECKOUT_MAX=30
RATE_LIMIT_TRACKING_MAX=120
RATE_LIMIT_ACTION_MAX=300
TRACKING_TTL_DAYS=90
CLEANUP_INTERVAL_MINUTES=15
SESSION_RETENTION_DAYS=7
LINK_INTENT_RETENTION_HOURS=24
ACTION_TOKEN_RETENTION_DAYS=7
WORKER_STALE_SECONDS=120
